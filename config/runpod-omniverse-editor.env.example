# Copy these values into RunPod secrets/environment.  Never commit real values.
FW_ACCEPT_NVIDIA_EULA=NO

# Ephemeral pod NVMe. No persistent/network volume is attached for this run.
FW_OMNI_WORKSPACE_MOUNT=/workspace
FW_OMNI_VOLUME_ROOT=/workspace/fireviewer-omniverse
FW_OMNI_STORAGE_MODE=ephemeral-nvme
FW_OMNI_MIN_STORAGE_GB=1500

# The external 20-zone metadata archive is small, but it must be immutable.
# HTTPS and the exact SHA-256 are mandatory when no catalog directory is mounted.
FW_OMNI_CATALOG_ARCHIVE_URL=
FW_OMNI_CATALOG_ARCHIVE_SHA256=
FW_OMNI_CATALOG_ALLOWED_HOSTS=
FW_SDG_ZONE_CATALOG_ROOT=

# Complete curated USD library.  Configure all three values together.
# The URL may be provided as a RunPod secret; redirects are intentionally not
# followed, and only the exact comma-separated HTTPS host allowlist is accepted.
# The archive manifest and every dependency path are portable paths relative to
# manifest-v3.json.  It must contain the seven near-ground PBR material roles
# (forest_floor, grass, soil, rock, asphalt, gravel, water) with >=2K square,
# hash/size/dimension-locked base_color, normal and roughness maps connected to
# the matching reachable branches of a native UsdShade surface network.  Each
# tree and building entry must also expose distinct local HERO/MID/FAR USD
# wrappers with a common locked source lineage; native validation requires
# bound renderable geometry, coherent bounds and a strictly decreasing
# geometric complexity. Setup installs the bundle below the pod NVMe,
# normalizes the runtime locks, then runs native PBR/LOD validation and
# the existing native USD quality validator.
FW_OMNI_ASSET_BUNDLE_URL=
FW_OMNI_ASSET_BUNDLE_SHA256=
FW_OMNI_ASSET_BUNDLE_ALLOWED_HOSTS=
FW_OMNI_ASSET_BUNDLE_MANIFEST_RELATIVE=manifest-v3.json
FW_OMNI_ASSET_BUNDLE_MAX_FILES=100000
FW_OMNI_ASSET_BUNDLE_MAX_UNPACKED_GIB=500
FW_OMNI_ASSET_BUNDLE_MAX_ARCHIVE_GIB=200
FW_OMNI_ASSET_BUNDLE_MIN_FREE_AFTER_INSTALL_GIB=100
FW_OMNI_ASSET_BUNDLE_CONNECT_TIMEOUT_SECONDS=30
FW_OMNI_ASSET_BUNDLE_DOWNLOAD_TIMEOUT_SECONDS=21600
# Hard stop for the pinned eight-UID Objaverse acquisition. Existing GLBs
# whose reviewed size/SHA-256 locks pass are reused without network access.
FW_OMNI_OBJAVERSE_DOWNLOAD_TIMEOUT_SECONDS=21600

# Exactly four already accepted base maps.  Fill this with the four catalog IDs
# bound to the imported base-map packages.  Five compositions are generated
# from each; the setup must not choose four unrelated zones automatically.
FW_OMNI_BASE_ZONES=
# Optional diagnostic/pilot phase only.  The final prepare phase processes all
# four bases and does not treat this one as the completed portfolio.
FW_OMNI_PILOT_ZONE=
# Full-zone downloads all 400 LiDAR tiles; review-cameras is a bounded pilot.
FW_OMNI_LIDAR_SCOPE=full-zone
FW_OMNI_DOWNLOAD_WORKERS=3
FW_OMNI_MIN_FREE_GIB=300
# Stable portfolio seed.  Changing it intentionally creates another complete
# 4 x 5 composition plan and therefore requires a new output volume/path.
FW_OMNI_MASTER_SEED=20260729
# Mandatory production profile: RTX PRO 6000 Blackwell Server Edition, 96 GB.
FW_OMNI_MIN_VRAM_MIB=90000
FW_OMNI_REQUIRED_GPU_NAME=RTX PRO 6000 Blackwell Server Edition
# Only the finite cgroup v1/v2 limit proves memory allocated to the container.
# /proc/meminfo is host inventory and is explicitly ignored. The production
# floor remains 138000 MiB; the receipt records the actual cgroup bytes/MiB.
FW_OMNI_MIN_SYSTEM_RAM_MIB=138000

# Shared PointInstancer budgets.  Geometry and textures remain shared.
FW_SDG_FOREST_INSTANCE_BUDGET=2500000
FW_SDG_PHOTOREAL_BUILDING_INSTANCE_LIMIT=20000

# Authenticated HTTP/TCP remote desktop for the real RTX Editor.
FW_OMNI_REVIEW_USER=fireviewer
FW_OMNI_REVIEW_PASSWORD=
FW_OMNI_EDITOR_TARGET_FPS=60
# The only pre-simulation manual-review target prepared by this workflow.
FW_OMNI_REVIEW_SCENE=SIM-01
FW_OMNI_VARIANT_SCENES_ROOT=/workspace/fireviewer-omniverse/variant-scenes
